rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict user-ownership model for all personal health data and a membership-based 
     * collaborative model for communication and care provider relationships.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isParticipant(req, participantList) {
      return req.auth != null && req.auth.uid in participantList;
    }

    // --- USER PROFILE & PERSONAL DATA ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      // Clinical reports and cross-report synthesis
      match /records/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Daily AI-generated synthesis
      match /synthesis/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Check-ins (quick tiles)
      match /checkins/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Health Journal entries (voice/text)
      match /journal/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Vitals data
      match /vitals/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Cycle data
      match /cycle/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Medication routines
      match /medications/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Relationship state
      match /relationship/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /appointments/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /referrals/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /healthGoals/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /notifications/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /familyMembers/{id} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // --- DIRECTORIES ---

    match /specialists/{specialistId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /careProviders/{careProviderId} {
      allow get, list: if isParticipant(request, resource.data.patientUserIds);
      allow create, update, delete: if false;
    }

    // --- COMMUNICATION ---

    match /conversations/{conversationId} {
      allow get, list: if isParticipant(request, resource.data.participantIds);
      allow create: if isParticipant(request, request.resource.data.participantIds);
      allow update: if isParticipant(request, resource.data.participantIds) && isParticipant(request, request.resource.data.participantIds);
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isParticipant(request, resource.data.participantIds);
        allow create: if isParticipant(request, request.resource.data.participantIds);
        allow update, delete: if false;
      }
    }
  }
}