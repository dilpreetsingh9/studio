{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a patient's profile, storing core demographic and health information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "firstName": {
          "type": "string",
          "description": "The user's first name."
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name."
        },
        "email": {
          "type": "string",
          "description": "The user's primary email address.",
          "format": "email"
        },
        "dateOfBirth": {
          "type": "string",
          "description": "The user's date of birth.",
          "format": "date"
        },
        "gender": {
          "type": "string",
          "description": "The user's gender."
        },
        "bloodType": {
          "type": "string",
          "description": "The user's blood type (e.g., A+, O-)."
        },
        "allergies": {
          "type": "array",
          "description": "A list of known allergies.",
          "items": {
            "type": "string"
          }
        },
        "healthFocus": {
          "type": "string",
          "description": "Primary health focus area."
        },
        "toneMode": {
          "type": "string",
          "enum": ["practical", "supportive"],
          "description": "The active tone mode for AI synthesis."
        },
        "reEngagementCount": {
          "type": "number",
          "description": "Count of times returning after absence."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "dateOfBirth",
        "gender"
      ]
    },
    "MedicalRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MedicalRecord",
      "type": "object",
      "description": "Represents an aggregated medical record entry.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "recordType": { "type": "string" },
        "source": { "type": "string" },
        "recordDate": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "recordType", "source", "recordDate", "title", "description"]
    },
    "Insight": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Insight",
      "type": "object",
      "description": "AI-powered insights generated from medical data.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "generatedDate": { "type": "string", "format": "date-time" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "riskCategory": { "type": "string" }
      },
      "required": ["id", "userId", "generatedDate", "title", "content", "riskCategory"]
    },
    "Synthesis": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Synthesis",
      "type": "object",
      "description": "Daily AI-generated health synthesis summary.",
      "properties": {
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Core demographic and health information."
        }
      },
      {
        "path": "users/{userId}/medicalRecords/{medicalRecordId}",
        "definition": {
          "entityName": "MedicalRecord",
          "schema": {
            "$ref": "#/backend/entities/MedicalRecord"
          },
          "description": "Individual medical record entries."
        }
      },
      {
        "path": "users/{userId}/insights/{insightId}",
        "definition": {
          "entityName": "Insight",
          "schema": {
            "$ref": "#/backend/entities/Insight"
          },
          "description": "AI-generated insights."
        }
      },
      {
        "path": "users/{userId}/synthesis/today",
        "definition": {
          "entityName": "Synthesis",
          "schema": {
            "$ref": "#/backend/entities/Synthesis"
          },
          "description": "Current daily AI synthesis summary."
        }
      }
    ]
  }
}