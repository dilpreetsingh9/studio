{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a patient's profile, storing core demographic and health information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "firstName": {
          "type": "string",
          "description": "The user's first name."
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name."
        },
        "email": {
          "type": "string",
          "description": "The user's primary email address.",
          "format": "email"
        },
        "dateOfBirth": {
          "type": "string",
          "description": "The user's date of birth.",
          "format": "date"
        },
        "gender": {
          "type": "string",
          "description": "The user's gender."
        },
        "bloodType": {
          "type": "string",
          "description": "The user's blood type (e.g., A+, O-)."
        },
        "allergies": {
          "type": "array",
          "description": "A list of known allergies.",
          "items": {
            "type": "string"
          }
        },
        "healthFocus": {
          "type": "string",
          "description": "Primary health focus area."
        },
        "toneMode": {
          "type": "string",
          "enum": ["practical", "supportive"],
          "description": "The active tone mode for AI synthesis."
        },
        "reEngagementCount": {
          "type": "number",
          "description": "Count of times returning after absence."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "dateOfBirth",
        "gender"
      ]
    },
    "Report": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Report",
      "type": "object",
      "description": "Scanned clinical report with extracted markers and Jeiva interpretations.",
      "properties": {
        "report_type": { "type": "string" },
        "lab_name": { "type": "string" },
        "report_date": { "type": "string" },
        "scan_date": { "type": "string", format: "date-time" },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "number" },
              "unit": { "type": "string" },
              "trend": { "type": "string" },
              "interpretation": { "type": "string" }
            }
          }
        },
        "jeiva_summary": { "type": "string" },
        "ocr_confidence": { "type": "number" },
        "unclear_markers": { "type": "array", items: { "type": "string" } },
        "imageUrl": { "type": "string" }
      },
      "required": ["report_type", "scan_date", "jeiva_summary"]
    },
    "HistorySynthesis": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HistorySynthesis",
      "type": "object",
      "description": "Cross-report clinical synthesis.",
      "properties": {
        "content": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "reports_included": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["content", "generated_at"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "type": "object",
      "properties": {
        "raw_entry": { "type": "string" },
        "ai_summary": { "type": "string" },
        "ai_tags": { "type": "array", "items": { "type": "string" } },
        "sentiment": { "type": "string" },
        "jeiva_observation": { "type": "string" },
        "log_type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "RelationshipState": {
      "title": "RelationshipState",
      "type": "object",
      "properties": {
        "days_active": { "type": "number" },
        "relationship_maturity": { "type": "string", "enum": ["new", "developing", "established", "deep"] },
        "most_consistent_behaviour": { "type": "string" },
        "biggest_change": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "google"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Core demographic and health information."
        }
      },
      {
        "path": "users/{userId}/records/{reportId}",
        "definition": {
          "entityName": "Report",
          "schema": {
            "$ref": "#/backend/entities/Report"
          },
          "description": "Individual scanned medical reports."
        }
      },
      {
        "path": "users/{userId}/records/synthesis",
        "definition": {
          "entityName": "HistorySynthesis",
          "schema": {
            "$ref": "#/backend/entities/HistorySynthesis"
          },
          "description": "Cross-report clinical synthesis."
        }
      },
      {
        "path": "users/{userId}/journal/{entryId}",
        "definition": {
          "entityName": "JournalEntry",
          "schema": {
            "$ref": "#/backend/entities/JournalEntry"
          },
          "description": "Daily reflections and observations."
        }
      },
      {
        "path": "users/{userId}/relationship/state",
        "definition": {
          "entityName": "RelationshipState",
          "schema": {
            "$ref": "#/backend/entities/RelationshipState"
          },
          "description": "Long-term relationship stats and AI reflections."
        }
      }
    ]
  }
}
