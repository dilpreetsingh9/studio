
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function — is the request from the owner of this data
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // User document — top level
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Consent Logs: Audit trail must be immutable and owner-write-only.
      match /consentLogs/{document} {
        allow create: if isOwner(uid) 
          && request.resource.data.userId == uid
          && request.resource.data.timestamp == request.time;
        // No client-side reads allowed for compliance logs; server-side audit only.
        allow read, update, delete: if false;
      }

      // Synthesis card
      match /synthesis/{document} {
        allow read, write: if isOwner(uid);
      }

      // Vitals
      match /vitals/{document} {
        allow read, write: if isOwner(uid);
      }

      // Cycle data
      match /cycle/{document} {
        allow read, write: if isOwner(uid);
      }

      // Check-ins
      match /checkins/{document} {
        allow read, write: if isOwner(uid);
      }

      // Journal entries
      match /journal/{document} {
        allow read, write: if isOwner(uid);
      }

      // Medications
      match /medications/{document} {
        allow read, write: if isOwner(uid);
      }

      // Lab results
      match /lab_results/{document} {
        allow read, write: if isOwner(uid);
      }

      // Scanned records — OCR feature
      match /records/{document} {
        allow read, write: if isOwner(uid);
      }

      // Records synthesis
      match /records/synthesis {
        allow read, write: if isOwner(uid);
      }

      // Relationship state
      match /relationship/{document} {
        allow read, write: if isOwner(uid);
      }

      // Catch-all for any other subcollections
      match /{subcollection}/{document} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
